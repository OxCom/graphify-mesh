# SECURITY: the real file holds the bearer token for the shared MCP server.
# It must be chmod 0600 and owned by the service user, never world-readable:
#   chmod 600 /path/to/your/workspace/graphify-mesh-server.env
#
# Server-only environment for graphify-mesh-server.service. The unit reads it
# AFTER the shared graphify-mesh-sync.env, so a key set here wins. Keep the
# token here, out of the sync env file and the sync process environment.
# This is NOT isolation: the sync engine's graphify children run as the same
# UID and can open this file as well. Real isolation means running the sync
# unit under a different UID from the one that owns this file. The server reads
# the token only from its environment.
# The permission audit only checks *.env files in the directory that holds
# registry.json. Anywhere else, nothing checks this file's mode: the chmod is
# on you. With the example paths (env files in the workspace, registry.json
# under graph-mesh/bin/), neither env file is audited.
# NOT sourced by a shell. systemd EnvironmentFile= parses KEY=VALUE lines
# directly. Copy to graphify-mesh-server.env and fill in the token.

# Bearer token for --transport http. Required, at least 32 characters.
# A blank value counts as absent and the daemon refuses to start (exit 2).
# Generate a fresh one, do not reuse a token from elsewhere:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
GRAPHIFY_MESH_HTTP_TOKEN=

# --- optional overrides -----------------------------------------------------
# Bind port (default 19744). The host stays 127.0.0.1 unless you also set
# GRAPHIFY_MESH_HTTP_HOST and GRAPHIFY_MESH_ALLOW_PUBLIC_BIND.
#GRAPHIFY_MESH_HTTP_PORT=19744
# Seconds a search waits for its query embedding (default 2.5). On timeout the
# search runs lexical/structural only and reports embeddings_unavailable:<reason>.
#GRAPHIFY_MESH_QUERY_EMBED_TIMEOUT=2.5
